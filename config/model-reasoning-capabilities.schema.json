{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuanzhejiang669-jpg/codex-feishu-bridge/model-reasoning-capabilities.schema.json",
  "type": "object",
  "required": ["schemaVersion", "registryVersion", "reviewAfterDays", "defaultRequestedEffort", "canonicalEfforts", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "registryVersion": {"type": "string", "minLength": 1},
    "reviewAfterDays": {"type": "integer", "minimum": 1},
    "defaultRequestedEffort": {"type": "string"},
    "canonicalEfforts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "entries": {"type": "array", "items": {"type": "object", "required": ["id", "name", "providerPatterns", "modelPatterns", "selectableEfforts", "defaultRequestedEffort", "maximumEffort", "controlKind", "mapping", "upstreamValues", "sourceUrl", "verifiedAt"], "properties": {"supportsReasoning": {"type": "boolean"}, "supportsVision": {"type": "boolean"}, "verificationNote": {"type": "string"}}}}
  }
}
