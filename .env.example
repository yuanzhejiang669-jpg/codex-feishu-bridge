# Optional overrides. Do not commit a real .env file.

# CODEX_FEISHU_WORKSPACE=C:\path\to\workspace
# Optional Codex home override. Usually prefer -CodexHome on the PowerShell scripts.
# CODEX_HOME=C:\path\to\codex-home
# CODEX_FEISHU_INSTANCE_NAME=codex-assistant-1
# CODEX_FEISHU_LARK_PROFILE=codex-assistant-1
# CODEX_FEISHU_SANDBOX=danger-full-access
# CODEX_FEISHU_RUN_MODE=app-server
# Comma-separated EventKeys. Keep the default unless the Feishu app and lark-cli both support extra events.
# CODEX_FEISHU_EVENT_KEYS=im.message.receive_v1
# CODEX_FEISHU_EVENT_KEYS=im.message.receive_v1,im.message.recalled_v1
# CODEX_FEISHU_MODEL=
# CODEX_FEISHU_REASONING=xhigh
# 0 disables the hard total timeout. Keep an idle timeout so stuck runs can be recovered.
# CODEX_FEISHU_CODEX_TIMEOUT_MS=0
# CODEX_FEISHU_CODEX_IDLE_TIMEOUT_MS=3600000
# CODEX_FEISHU_MAX_CONCURRENT=1
# CODEX_FEISHU_MAX_REPLY_CHARS=6000
# CODEX_FEISHU_CARD_MODE=1
# CODEX_FEISHU_CARD_THROTTLE_MS=400
# CODEX_FEISHU_SHOW_FINAL_STEPS=1
# CODEX_FEISHU_REPLY_TO_MESSAGE=0
# CODEX_FEISHU_REPLY_IN_THREAD=0
# CODEX_FEISHU_DISABLE_MCP=0
# CODEX_FEISHU_SYNC_SESSIONS_FROM_CODEX=1
# CODEX_FEISHU_SYNC_SIDEBAR=0
# CODEX_FEISHU_MAX_FILE_ATTACHMENT_BYTES=52428800
# CODEX_FEISHU_RECALLED_MESSAGE_TTL_MS=86400000

# Tool paths. Usually not needed when codex.exe and lark-cli.cmd are on PATH.
# CODEX_CLI_BIN=C:\path\to\codex.exe
# LARK_CLI_BIN=C:\Users\<you>\AppData\Roaming\npm\lark-cli.cmd

# Optional Codex model provider keys used by provider switching.
# The startup script imports these from the Windows User environment into the
# Bridge process when they are missing from the process environment.
# SUB2API_API_KEY=<secret>
# LTHOME_API_KEY=<secret>
# MUYUAN_API_KEY=<secret>
# ANYROUTER_API_KEY=<secret>
# ICOE_API_KEY=<secret>
# CLIPROXY_API_KEY=<secret>
# MIMO2CODEX_KEY=<local-proxy-secret>
# DEEPSEEK_API_KEY=<secret>
# DS_API_KEY=<secret>
# APIDEEPSEEK_API_KEY=<secret>
# KIMI_API_KEY=<secret>
# GLM_API_KEY=<secret>
# XAI_API_KEY=<secret>
