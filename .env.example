# Optional overrides. Do not commit a real .env file.

# CODEX_FEISHU_WORKSPACE=C:\path\to\workspace
# CODEX_FEISHU_INSTANCE_NAME=codex-assistant-1
# CODEX_FEISHU_LARK_PROFILE=codex-assistant-1
# CODEX_FEISHU_SANDBOX=danger-full-access
# CODEX_FEISHU_RUN_MODE=app-server
# CODEX_FEISHU_MODEL=
# CODEX_FEISHU_REASONING=xhigh
# CODEX_FEISHU_CODEX_TIMEOUT_MS=7200000
# CODEX_FEISHU_MAX_CONCURRENT=1
# CODEX_FEISHU_MAX_REPLY_CHARS=6000
# CODEX_FEISHU_CARD_MODE=1
# CODEX_FEISHU_CARD_THROTTLE_MS=400
# CODEX_FEISHU_SHOW_FINAL_STEPS=1
# CODEX_FEISHU_REPLY_TO_MESSAGE=0
# CODEX_FEISHU_REPLY_IN_THREAD=0
# CODEX_FEISHU_DISABLE_MCP=0
# CODEX_FEISHU_SYNC_SESSIONS_FROM_CODEX=1
# CODEX_FEISHU_SYNC_SIDEBAR=0
# CODEX_FEISHU_MAX_FILE_ATTACHMENT_BYTES=52428800

# Tool paths. Usually not needed when codex.exe and lark-cli.cmd are on PATH.
# CODEX_CLI_BIN=C:\path\to\codex.exe
# LARK_CLI_BIN=C:\Users\<you>\AppData\Roaming\npm\lark-cli.cmd
